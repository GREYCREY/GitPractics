<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="300" Width="500">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="23*"/>
        </Grid.ColumnDefinitions>

        <!-- Edit Contact Section -->
        <GroupBox Header="Edit Contact" Margin="5,3,5,7">
            <StackPanel Margin="10">
                <TextBlock Text="Name:" Margin="0,0,0,3"/>
                <TextBox Name="NameBox" 
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10"/>

                <TextBlock Text="Phone Number:" Margin="0,0,0,5"/>
                <TextBox Name="PhoneBox" 
                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10"/>

                <TextBlock Text="Email:" Margin="0,0,0,5"/>
                <TextBox Name="EmailBox" 
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </GroupBox>

        <!-- Read Contact Section -->
        <GroupBox Header="Read Contact" Grid.Column="1" Margin="3,3,3,3" Grid.ColumnSpan="2">
            <StackPanel Margin="10">
                <TextBlock Text="Name:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Name}" Margin="0,0,0,10"/>

                <TextBlock Text="Phone Number:" FontWeight="Bold"/>
                <TextBlock Text="{Binding PhoneNumber}" Margin="0,0,0,10"/>

                <TextBlock Text="Email:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Email}"/>
            </StackPanel>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" VerticalAlignment="Bottom" 
                    HorizontalAlignment="Right" Grid.Column="1" Height="40" Width="200">
            <Button Content="Save" Width="75" Height="25" Margin="3" Command="{Binding SaveCommand}"/>
            <Button Content="Load" Width="75" Height="25" Margin="3" Command="{Binding LoadCommand}"/>

        </StackPanel>
    </Grid>
</Window>
